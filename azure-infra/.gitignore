# =============================================================================
# Terraform .gitignore
# =============================================================================

# Local .terraform directory — contains downloaded provider binaries and module
# cache. This directory can be hundreds of MB and is fully reproducible by
# running `terraform init`. Never commit it.
.terraform/

# Dependency lock file — DO commit this. It pins provider versions so every
# contributor and CI run gets the exact same provider binary.
# .terraform.lock.hcl  <-- intentionally NOT ignored

# State files — may contain sensitive values (passwords, keys, connection
# strings) in plaintext. State should be stored remotely (e.g. Azure Blob,
# HCP Terraform) and never committed to version control.
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup

# Terraform plan output files — binary files produced by `terraform plan -out`.
# Can contain sensitive data and are environment-specific.
*.tfplan

# Variable definition files — commonly used to supply sensitive values
# (credentials, secrets, environment-specific settings) that must not be
# committed. Use a *.tfvars.example file to document expected variables instead.
*.tfvars
*.tfvars.json

# Exception: allow example/template tfvars files that document expected inputs
# without containing real values.
!*.tfvars.example
!*.tfvars.json.example

# Crash log — generated by Terraform when it encounters a bug. Contains
# internal state and stack traces that are not useful to commit.
crash.log
crash.*.log

# Override files — used for local development overrides. These are intentionally
# excluded from version control so they do not affect other contributors.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration — personal CLI config file that may contain credentials.
.terraformrc
terraform.rc

# =============================================================================
# OS and editor artifacts
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/

# JetBrains (IntelliJ, GoLand, etc.)
.idea/

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#
